<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://stano.com/database"
        xmlns:database="http://stano.com/database"
        elementFormDefault="qualified"
        attributeFormDefault="unqualified"
        version="1.2.0">
  <element name="database">
    <complexType>
      <sequence>
        <choice minOccurs="0" maxOccurs="unbounded">
          <group ref="database:schemaObjects"/>

          <element name="schema">
            <complexType>
              <sequence>
                <group ref="database:schemaObjects" minOccurs="0" maxOccurs="unbounded"/>
              </sequence>
              <attribute name="name" type="string" use="required"/>
            </complexType>
          </element>
        </choice>
      </sequence>
      <attribute name="foreignKeyMode" type="database:foreignKeyMode"/>
      <attribute name="booleanMode" type="database:booleanMode"/>
      <attribute name="caseSensitiveText" type="boolean"/>
    </complexType>
  </element>

  <group name="schemaObjects">
    <choice>
      <element name="table" type="database:tableType"/>
      <element name="enum" type="database:enumType"/>
      <element name="view" type="database:viewType"/>
      <element name="function" type="database:functionType"/>
      <element name="procedure" type="database:procedureType"/>
      <element name="otherSql" type="database:otherSqlType"/>
    </choice>
  </group>

  <complexType name="tableType">
    <all>
      <element name="columns" minOccurs="1" maxOccurs="1">
        <complexType>
          <sequence>
            <element name="column" minOccurs="1" maxOccurs="unbounded">
              <complexType>
                <sequence>
                  <!-- A check without databaseType is the generic fallback, used for any database that has
                       no check of its own. A check with databaseType applies to that database only and
                       takes precedence over the generic one. Declare at most one check per databaseType
                       and at most one generic check. -->
                  <element name="check" minOccurs="0" maxOccurs="unbounded">
                    <complexType>
                      <simpleContent>
                        <extension base="string">
                          <attribute name="databaseType" type="database:databaseTypeEnum"/>
                        </extension>
                      </simpleContent>
                    </complexType>
                  </element>
                </sequence>
                <!-- Conditional rules XSD 1.0 cannot express; generators and linters should enforce them:
                     type="enum" requires enumType (naming an enum), type="array" requires elementType,
                     type="decimal" requires length (precision) and may set scale (scale <= length), and
                     char/varchar/binary take length. enumType and elementType are meaningless on other types. -->
                <attribute name="name" type="string" use="required"/>
                <attribute name="type" type="database:columnEnum" use="required"/>
                <attribute name="length" type="nonNegativeInteger"/>
                <attribute name="scale" type="nonNegativeInteger"/>
                <attribute name="required" type="boolean">
                  <annotation>
                    <documentation>True means NOT NULL.</documentation>
                  </annotation>
                </attribute>
                <attribute name="default" type="string">
                  <annotation>
                    <documentation>A SQL expression copied verbatim into DEFAULT.</documentation>
                  </annotation>
                </attribute>
                <attribute name="generated" type="string">
                  <annotation>
                    <documentation>A SQL expression for a computed (generated) column.</documentation>
                  </annotation>
                </attribute>
                <attribute name="enumType" type="string"/>
                <attribute name="elementType" type="database:columnEnum"/>
                <attribute name="minValue" type="decimal">
                  <annotation>
                    <documentation>Minimum allowed value, enforced through a generated CHECK constraint.</documentation>
                  </annotation>
                </attribute>
                <attribute name="maxValue" type="decimal">
                  <annotation>
                    <documentation>Maximum allowed value, enforced through a generated CHECK constraint.</documentation>
                  </annotation>
                </attribute>
              </complexType>
              <!-- XSD 1.0 skips elements with no databaseType, so this only stops duplicate
                   database-specific checks; a second generic check is not caught. -->
              <unique name="uniqueColumnCheckDatabaseType">
                <selector xpath="database:check"/>
                <field xpath="@databaseType"/>
              </unique>
            </element>
          </sequence>
        </complexType>
      </element>

      <element name="keys" minOccurs="0" maxOccurs="1">
        <complexType>
          <sequence>
            <element name="primary" minOccurs="0" maxOccurs="1">
              <complexType>
                <sequence>
                  <element name="column" maxOccurs="unbounded">
                    <complexType>
                      <attribute name="name" type="string" use="required"/>
                    </complexType>
                  </element>
                </sequence>
                <attribute name="cluster" type="boolean" default="false"/>
              </complexType>
            </element>

            <element name="unique" minOccurs="0" maxOccurs="unbounded">
              <complexType>
                <sequence>
                  <element name="column" maxOccurs="unbounded">
                    <complexType>
                      <attribute name="name" type="string" use="required"/>
                    </complexType>
                  </element>
                </sequence>
                <attribute name="cluster" type="boolean" default="false"/>
                <attribute name="where" type="string"/>
              </complexType>
            </element>

            <element name="index" minOccurs="0" maxOccurs="unbounded">
              <complexType>
                <sequence>
                  <element name="column" maxOccurs="unbounded">
                    <complexType>
                      <attribute name="name" type="string" use="required"/>
                    </complexType>
                  </element>
                </sequence>
                <attribute name="include" type="string"/>
                <attribute name="compress" type="boolean" default="false"/>
                <attribute name="unique" type="boolean" default="false"/>
                <attribute name="where" type="string"/>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>

      <element name="relations" minOccurs="0" maxOccurs="1">
        <complexType>
          <choice minOccurs="1" maxOccurs="unbounded">
            <element name="relation">
              <complexType>
                <attribute name="src" type="string" use="required"/>
                <attribute name="table" type="string" use="required"/>
                <attribute name="column" type="string" use="required"/>
                <attribute name="type" type="database:relationTypeEnum" use="required"/>
                <attribute name="disableUsageChecking" type="boolean">
                  <annotation>
                    <documentation>Metadata for model consumers: an application-level "where is this row used?" check skips the relation. No DDL or migration reads it.</documentation>
                  </annotation>
                </attribute>
              </complexType>
            </element>

            <!-- Composite (multi-column) foreign key: each <column> pairs one local column
                 (src) with the column it maps to on the target table (name). -->
            <element name="compositeRelation">
              <complexType>
                <sequence minOccurs="2" maxOccurs="unbounded">
                  <element name="column">
                    <complexType>
                      <attribute name="src" type="string" use="required"/>
                      <attribute name="name" type="string" use="required"/>
                    </complexType>
                  </element>
                </sequence>
                <attribute name="table" type="string" use="required"/>
                <attribute name="type" type="database:relationTypeEnum" use="required"/>
                <attribute name="disableUsageChecking" type="boolean">
                  <annotation>
                    <documentation>Metadata for model consumers: an application-level "where is this row used?" check skips the relation. No DDL or migration reads it.</documentation>
                  </annotation>
                </attribute>
              </complexType>
            </element>
          </choice>
        </complexType>
      </element>

      <element name="triggers" minOccurs="0" maxOccurs="1">
        <complexType>
          <sequence>
            <choice minOccurs="0" maxOccurs="unbounded">
              <element name="update" type="database:triggerType">
                <annotation>
                  <documentation>SQL appended to the generated insert-or-update trigger body for this table, so it also runs on INSERT. PostgreSQL: use TG_OP to tell them apart. SQL Server: the Inserted/Deleted pseudo-tables cover both.</documentation>
                </annotation>
              </element>
              <element name="delete" type="database:triggerType">
                <annotation>
                  <documentation>SQL appended to the generated delete trigger body for this table.</documentation>
                </annotation>
              </element>
            </choice>
          </sequence>
        </complexType>
      </element>

      <element name="constraints" minOccurs="0" maxOccurs="1">
        <complexType>
          <sequence>
            <element name="constraint" minOccurs="1" maxOccurs="unbounded">
              <complexType>
                <simpleContent>
                  <extension base="string">
                    <attribute name="name" type="string" use="required"/>
                    <attribute name="databaseType" type="database:databaseTypeEnum"/>
                  </extension>
                </simpleContent>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>

      <element name="aggregations" minOccurs="0" maxOccurs="1">
        <complexType>
          <sequence minOccurs="1" maxOccurs="unbounded">
            <element name="aggregate">
              <complexType>
                <sequence>
                  <choice minOccurs="1" maxOccurs="unbounded">
                    <element name="sum">
                      <complexType>
                        <attribute name="sourceColumn" type="string" use="required"/>
                        <attribute name="destinationColumn" type="string" use="required"/>
                      </complexType>
                    </element>
                    <element name="count">
                      <complexType>
                        <attribute name="destinationColumn" type="string" use="required"/>
                      </complexType>
                    </element>
                  </choice>
                  <element name="group">
                    <complexType>
                      <sequence minOccurs="1" maxOccurs="unbounded">
                        <element name="column">
                          <complexType>
                            <attribute name="source" type="string" use="required"/>
                            <attribute name="destination" type="string" use="required"/>
                            <attribute name="sourceDerivedFrom" type="string"/>
                          </complexType>
                        </element>

                      </sequence>
                    </complexType>
                  </element>
                </sequence>
                <attribute name="destinationTable" type="string" use="required"/>
                <attribute name="dateColumn" type="string" use="required"/>
                <attribute name="timestampColumn" type="string" use="required"/>
                <attribute name="frequency" type="database:aggregationFrequencyEnum" use="required"/>
                <attribute name="criteria" type="string"/>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>

      <element name="initialData" minOccurs="0" maxOccurs="1">
        <complexType>
          <sequence>
            <element name="sql" minOccurs="1" maxOccurs="unbounded">
              <complexType>
                <simpleContent>
                  <extension base="string">
                    <attribute name="databaseType" type="database:databaseTypeEnum"/>
                  </extension>
                </simpleContent>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>
    </all>

    <attribute name="name" type="string" use="required"/>
    <attribute name="data" type="boolean">
      <annotation>
        <documentation>Marks a table whose rows are data rather than structure (reference data, see initialData).</documentation>
      </annotation>
    </attribute>
    <attribute name="noExport" type="boolean">
      <annotation>
        <documentation>Excludes the table from data export.</documentation>
      </annotation>
    </attribute>
    <attribute name="exportDataColumn" type="string">
      <annotation>
        <documentation>The column used to track export/change dates (date-based export).</documentation>
      </annotation>
    </attribute>
    <attribute name="compress" type="boolean" default="false">
      <annotation>
        <documentation>Creates the table compressed, on databases that support it.</documentation>
      </annotation>
    </attribute>
    <attribute name="lockEscalation" type="database:lockEscalationEnum" default="auto">
      <annotation>
        <documentation>Row-lock escalation, honored by SQL Server only (LOCK_ESCALATION): table escalates to a table lock, auto lets the engine choose, disable never escalates.</documentation>
      </annotation>
    </attribute>
  </complexType>

  <complexType name="viewType">
    <simpleContent>
      <extension base="string">
        <attribute name="name" type="string" use="required"/>
        <attribute name="databaseType" type="database:databaseTypeEnum"/>
      </extension>
    </simpleContent>
  </complexType>

  <complexType name="functionType">
    <sequence>
      <element name="sql" type="database:vendorSqlType" minOccurs="1" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="name" type="string" use="required"/>
  </complexType>

  <complexType name="procedureType">
    <sequence>
      <element name="sql" type="database:vendorSqlType" minOccurs="1" maxOccurs="unbounded"/>
    </sequence>
    <attribute name="name" type="string" use="required"/>
  </complexType>

  <complexType name="vendorSqlType">
    <simpleContent>
      <extension base="string">
        <attribute name="databaseType" type="database:databaseTypeEnum" use="required"/>
      </extension>
    </simpleContent>
  </complexType>

  <complexType name="otherSqlType">
    <simpleContent>
      <extension base="string">
        <attribute name="databaseType" type="database:databaseTypeEnum" use="required"/>
        <attribute name="order" type="database:otherSqlOrderType" use="required"/>
      </extension>
    </simpleContent>
  </complexType>

  <simpleType name="otherSqlOrderType">
    <restriction base="string">
      <enumeration value="top"/>
      <enumeration value="bottom"/>
    </restriction>
  </simpleType>

  <complexType name="triggerType">
    <simpleContent>
      <extension base="string">
        <attribute name="databaseType" type="database:databaseTypeEnum" use="required"/>
      </extension>
    </simpleContent>
  </complexType>

  <complexType name="enumType">
    <sequence>
      <element name="value" minOccurs="1" maxOccurs="unbounded">
        <complexType>
          <attribute name="name" type="string" use="required"/>
          <attribute name="code" type="string"/>
        </complexType>
      </element>
    </sequence>
    <attribute name="name" type="string" use="required"/>
  </complexType>

<simpleType name="columnEnum">
    <annotation>
      <documentation>Column data types. Each maps to the closest native type of the target database.</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="sequence">
        <annotation>
          <documentation>Auto-incrementing integer column (serial, identity). A table may have at most one sequence or longsequence column.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="longsequence">
        <annotation>
          <documentation>Auto-incrementing bigint column (bigserial, identity). A table may have at most one sequence or longsequence column.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="byte"/>
      <enumeration value="short"/>
      <enumeration value="int"/>
      <enumeration value="long"/>
      <enumeration value="float"/>
      <enumeration value="double"/>
      <enumeration value="decimal"/>
      <enumeration value="boolean"/>
      <enumeration value="date"/>
      <enumeration value="time"/>
      <enumeration value="datetime"/>
      <enumeration value="timestamp"/>
      <enumeration value="timestamptz"/>
      <enumeration value="char"/>
      <enumeration value="varchar"/>
      <enumeration value="enum"/>
      <enumeration value="text"/>
      <enumeration value="citext">
        <annotation>
          <documentation>Case-insensitive text. Maps to plain text where the database has no dedicated type.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="cstext">
        <annotation>
          <documentation>Case-sensitive text. Maps to plain text where the database has no dedicated type.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="binary"/>
      <enumeration value="uuid"/>
      <enumeration value="json"/>
      <enumeration value="array"/>
    </restriction>
  </simpleType>

  <simpleType name="aggregationFrequencyEnum">
    <restriction base="string">
      <enumeration value="daily"/>
      <enumeration value="weekly"/>
      <enumeration value="monthly"/>
      <enumeration value="yearly"/>
    </restriction>
  </simpleType>

<simpleType name="relationTypeEnum">
    <annotation>
      <documentation>What happens to child rows when the referenced (parent) row is deleted, i.e. the ON DELETE action. There is no ON UPDATE action. Applies to relation and compositeRelation, in both foreignKeyMode="relations" (FOREIGN KEY constraint) and "triggers" (generated triggers). SET DEFAULT is not supported.</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="cascade">
        <annotation>
          <documentation>Delete the child rows (ON DELETE CASCADE).</documentation>
        </annotation>
      </enumeration>
      <enumeration value="enforce">
        <annotation>
          <documentation>Reject the delete while child rows exist, and require inserted/updated child values to exist in the parent. FK constraint with the default action.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="setnull">
        <annotation>
          <documentation>Set the child columns to null (ON DELETE SET NULL). Invalid if the child column is required.</documentation>
        </annotation>
      </enumeration>
      <enumeration value="donothing">
        <annotation>
          <documentation>No integrity enforcement: no FOREIGN KEY constraint and no triggers. The relation only documents the link (e.g. for diagrams).</documentation>
        </annotation>
      </enumeration>
    </restriction>
  </simpleType>

<simpleType name="databaseTypeEnum">
    <annotation>
      <documentation>Target database for vendor-specific SQL. On view, constraint and initialData sql the attribute is optional because that SQL is usually portable: no databaseType means it applies to every database. It is required on trigger, function, procedure and otherSql, whose SQL is inherently vendor-specific.</documentation>
    </annotation>
    <restriction base="string">
      <enumeration value="h2"/>
      <enumeration value="postgresql"/>
      <enumeration value="sqlite"/>
      <enumeration value="sqlserver"/>
    </restriction>
  </simpleType>

  <simpleType name="lockEscalationEnum">
    <restriction base="string">
      <enumeration value="table"/>
      <enumeration value="auto"/>
      <enumeration value="disable"/>
    </restriction>
  </simpleType>

  <simpleType name="foreignKeyMode">
    <restriction base="string">
      <enumeration value="relations"/>
      <enumeration value="triggers"/>
    </restriction>
  </simpleType>

  <simpleType name="booleanMode">
    <restriction base="string">
      <enumeration value="native"/>
      <enumeration value="yes_no"/>
      <enumeration value="yn"/>
    </restriction>
  </simpleType>
</schema>
